# PostgreSQL / Supabase connection string for the normalized Database-branch schema.
# Leave unset to use the local SQLite prototype database.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Required only when using/synchronizing the Neo4j academic knowledge graph.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# The current week is calculated from this date and advances every Saturday.
AEGIS_CURRENT_SEMESTER=Fall 2026
AEGIS_SEMESTER_START_DATE=2026-08-08

# Private source-file directory for the course-material library.
AEGIS_MATERIAL_STORAGE_ROOT=workspace/materials

# Standalone PDF file server (python -m uvicorn backend.portal_pdf_service:app).
# No academic database or migration is used by this service.
AEGIS_PDF_STORAGE_ROOT=workspace/materials/portal-pdfs
AEGIS_ACADEMIC_API_URL=https://web-production-3a6ad.up.railway.app
AEGIS_PORTAL_ORIGINS=http://127.0.0.1:5174,http://localhost:5174

# Required by the authenticated Staff/Student PDF endpoints on the API.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key
AEGIS_STAFF_IDS=104217
# In production this directory must be on a persistent, private volume shared by API instances.

# Required only for Advisor and Progress-Agent Gemini recommendations.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=30000

# Public desktop meetings (configure these on the host machine only).
# Set to 1 to automatically create a temporary trycloudflare.com URL.
# AEGIS_MEETING_QUICK_TUNNEL=0
# AEGIS_MEETING_BIND=127.0.0.1
# AEGIS_MEETING_PUBLIC_URL=wss://meet.example.com
# AEGIS_MEETING_TURN_URLS=["turn:turn.example.com:3478?transport=udp","turn:turn.example.com:3478?transport=tcp","turns:turn.example.com:443?transport=tcp"]
# Generate a private value with: openssl rand -hex 32
# Use the same value as coturn's static-auth-secret; never commit it.
# AEGIS_MEETING_TURN_SECRET=replace_with_at_least_32_random_characters
# AEGIS_MEETING_TURN_TTL_SECONDS=86400
# Set to 1 only when testing that all media is using TURN.
# AEGIS_MEETING_RELAY_ONLY=0
