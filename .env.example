# PostgreSQL / Supabase connection string for the normalized Database-branch schema.
# Leave unset to use the local SQLite prototype database.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# These are display/context values only until the portal schema provides term/week fields.
AEGIS_CURRENT_SEMESTER=Fall 2026
AEGIS_CURRENT_WEEK=1

# Required only for Advisor and Progress-Agent Gemini recommendations.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
